# ============ 多智能体办公助手 · 环境变量模板 ============
# 使用：复制本文件为 .env，填入 DEEPSEEK_API_KEY（其余由初始化脚本生成）

# ---- 应用 ----
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8010
LOG_LEVEL=INFO
UPLOAD_DIR=./data/uploads

# ---- MySQL（三库：OA 模拟 / 资产台账 / 应用数据）----
MYSQL_HOST=localhost
MYSQL_PORT=3309
MYSQL_USER=office
MYSQL_PASSWORD=<数据库密码>
MYSQL_ROOT_PASSWORD=<root密码>
MYSQL_DB_OA=office_oa
MYSQL_DB_ASSET=office_asset
MYSQL_DB_APP=office_app

# ---- 模型（provider 链：默认只启用 deepseek；备用 provider 留空即关闭）----
DEEPSEEK_API_KEY=<你的 DeepSeek Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---- 知识库（Milvus + BGE-M3；模型可用绝对路径指向本地权重）----
MILVUS_HOST=localhost
MILVUS_PORT=19532
KB_COLLECTION=office_kb
BGE_M3_MODEL_PATH=<BGE-M3 模型目录绝对路径>

# ---- 内部服务 ----
MOCK_INTERNAL_URL=http://localhost:8210
OA_MCP_URL=http://localhost:8111/mcp
ASSET_MCP_URL=http://localhost:8112/mcp
MCP_SHARED_KEY=<服务间鉴权 Key>
MEETING_QUERY_AGENT_URL=http://localhost:5011
MEETING_BOOK_AGENT_URL=http://localhost:5012
EQUIPMENT_QUERY_AGENT_URL=http://localhost:5013
EQUIPMENT_REPAIR_AGENT_URL=http://localhost:5014
RAG_AGENT_URL=http://localhost:5015

# ---- 超时 / 重试 ----
MCP_TIMEOUT_SECONDS=5
A2A_TIMEOUT_SECONDS=15
LLM_RETRY_TIMES=3

# ---- 安全 ----
JWT_SECRET=<随机字符串>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 站内提醒 ----
REMINDER_ENABLED=true
REMINDER_INTERVAL_SECONDS=60
REMINDER_LEAD_MINUTES=15